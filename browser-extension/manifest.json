{
  "manifest_version": 3,
  "name": "ScribeLane Webex",
  "version": "1.0.0",
  "description": "Send the Webex playlist for one ScribeLane tab to the desktop app.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.webex.com/*",
    "https://*.webex.com.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
