{
  "manifest_version": 3,
  "name": "ScribeLane Webex",
  "version": "1.1.0",
  "description": "Send a playlist URL from your authorized Webex recording to the ScribeLane desktop app on this computer.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.webex.com/*",
    "https://*.webex.com.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle",
      "css": [
        "bridge.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
