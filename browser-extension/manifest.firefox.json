{
  "manifest_version": 3,
  "name": "ScribeLane Webex",
  "version": "1.1.0",
  "description": "Send a playlist URL from your authorized Webex recording to the ScribeLane desktop app on this computer.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.webex.com/*",
    "https://*.webex.com.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle",
      "css": [
        "bridge.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webex@scribelane.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
