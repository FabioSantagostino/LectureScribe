{
  "manifest_version": 3,
  "name": "LectureScribe Webex",
  "version": "1.0.0",
  "description": "Send the Webex playlist for one LectureScribe tab to the desktop app.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.webex.com/*",
    "https://*.webex.com.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webex@lecturescribe.local",
      "strict_min_version": "126.0"
    }
  }
}
